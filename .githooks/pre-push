#!/bin/sh
# Verhindert Pushes direkt auf master/main (Änderungen immer über Branch und Pull Request)
while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/master|refs/heads/main) echo "Direkter Push auf ${remote_ref#refs/heads/} ist gesperrt - bitte Branch + Pull Request nutzen."; exit 1;;
  esac
done
exit 0